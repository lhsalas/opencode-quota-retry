{
  "name": "opencode-quota-retry",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Process-local OpenCode retry manager for OpenAI usage-limit failures, with TUI and Desktop notifications.",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment node"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^5.1.0"
  }
}
